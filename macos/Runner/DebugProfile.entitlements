<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Same story as Release.entitlements: no sandbox, or the tool cannot touch
     ~/Library/LaunchAgents or talk to launchctl. allow-jit stays because the
     debug and profile engines need it for the Dart VM. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
</dict>
</plist>
